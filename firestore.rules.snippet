// 商圈精耕系統（sqfarm）— 貼到 Firebase 主控台 → Firestore Database → 規則
// 放在既有的 match /databases/{database}/documents { ... } 裡面，與 RE-CMS 原有規則並列即可
    match /sqfarm/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
